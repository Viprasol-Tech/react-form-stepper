  },
  "homepage": "https://viprasol.com",
  "bugs": {
    "url": "https://github.com/Viprasol-Tech/react-form-stepper/issues"
  },
  "keywords": [
    "react",
    "form",
    "stepper",
    "wizard",
    "multi-step",
    "typescript",
    "ui-components",
    "headless",
    "accessible",
    "react-hook",
    "async-validation"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
